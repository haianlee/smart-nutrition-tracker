# Google Gemini API Key (可於 https://aistudio.google.com 免費取得)
GEMINI_API_KEY=

# 伺服器連接埠
PORT=3001

# 預設維持熱量 (TDEE) 與目標熱量
TDEE=2200
TARGET_CALORIES=1900

# 郵件通知 SMTP 設定 (選填，亦可在網頁 UI 設定)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_RECIPIENT=your_email@gmail.com
