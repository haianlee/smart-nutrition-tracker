{
  "name": "smart-nutrition-weight-tracker",
  "version": "1.0.0",
  "type": "module",
  "description": "Mobile-friendly AI food calorie analysis and weight tracking app with Gemini vision",
  "main": "server/index.js",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --prefix client run build"
  },
  "dependencies": {
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
